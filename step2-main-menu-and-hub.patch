+++ b/scripts/world/walkable_area.gd
@@ -0,0 +1,152 @@
+extends Node3D
+class_name WalkableArea
+## Base for the main menu and the hub: a small walkable room with the iso camera,
+## spawned players, interact zones and a themed HUD. Subclasses set `room_size`
+## in _init(), override _spawn_point(), and add zones in _ready() after super().
+##
+## Players here cannot grab anything (can_interact is false). Pressing interact
+## on a zone emits that zone's `interacted` signal.
+
+const WALL_HEIGHT := 1.2   # same low walls as the test house, to keep the iso view readable
+const WALL_THICKNESS := 0.3
+const FLOOR_COLOR := Color(0.78, 0.65, 0.5)
+const WALL_COLOR := Color(0.9, 0.88, 0.8)
+
+## x and z extent of the room, centred on the origin. Set it in the subclass _init().
+var room_size := Vector2(20.0, 12.0)
+
+var _zones: Array[InteractZone] = []
+var _interact_prev: Dictionary[int, bool] = {}
+
+
+func _ready() -> void:
+	_build_environment()
+	_build_room()
+	add_child(IsoCamera.new())
+	for player_id in range(1, InputSetup.assigned_count() + 1):
+		spawn_player(player_id)
+
+
+func _physics_process(_delta: float) -> void:
+	for player: Player in get_tree().get_nodes_in_group("players"):
+		var pressed := InputSetup.is_interact_pressed(InputSetup.source_of(player.player_id))
+		if pressed and not _interact_prev.get(player.player_id, true):
+			for zone in _zones:
+				if zone.players_inside().has(player):
+					zone.interacted.emit(player.player_id)
+		_interact_prev[player.player_id] = pressed
+
+
+## Where `player_id` appears. Override in the subclass.
+func _spawn_point(_player_id: int) -> Vector3:
+	return Vector3(0.0, 0.1, 0.0)
+
+
+func spawn_player(player_id: int) -> void:
+	var player := Player.new()
+	player.player_id = player_id
+	player.can_interact = false
+	player.position = _spawn_point(player_id)
+	add_child(player)
+	# A button still held from the join (or the previous screen) must be released
+	# before it counts as a zone press.
+	_interact_prev[player_id] = InputSetup.is_interact_pressed(InputSetup.source_of(player_id))
+
+
+func add_zone(center: Vector3, size: Vector3, color: Color, text: String) -> InteractZone:
+	var zone := InteractZone.new(size, color, text)
+	zone.position = center
+	add_child(zone)
+	_zones.append(zone)
+	return zone
+
+
+## Builds the screen layout (title banner on top, status note at the bottom) and
+## returns the status label for the subclass to update.
+func _build_hud(title: String) -> Label:
+	var layer := CanvasLayer.new()
+	add_child(layer)
+	var root := UIKit.setup(layer)
+
+	var margin := MarginContainer.new()
+	margin.set_anchors_preset(Control.PRESET_FULL_RECT)
+	margin.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	for side in ["left", "top", "right", "bottom"]:
+		margin.add_theme_constant_override("margin_" + side, 40)
+	root.add_child(margin)
+
+	var column := VBoxContainer.new()
+	column.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	margin.add_child(column)
+
+	var banner := PanelContainer.new()
+	banner.theme_type_variation = &"BannerPanel"
+	banner.custom_minimum_size = Vector2(1300, 0)
+	banner.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
+	banner.add_child(UIKit.label(title, UIKit.FONT_TITLE, HORIZONTAL_ALIGNMENT_CENTER))
+	column.add_child(banner)
+
+	var spacer := Control.new()
+	spacer.size_flags_vertical = Control.SIZE_EXPAND_FILL
+	spacer.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	column.add_child(spacer)
+
+	var note := PanelContainer.new()
+	note.theme_type_variation = &"NotePanel"
+	note.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
+	var status := UIKit.label("", UIKit.FONT_BODY, HORIZONTAL_ALIGNMENT_LEFT, &"DarkLabel")
+	note.add_child(status)
+	column.add_child(note)
+	return status
+
+
+# --- world ----------------------------------------------------------------
+
+func _build_environment() -> void:
+	var env := Environment.new()
+	env.background_mode = Environment.BG_COLOR
+	env.background_color = Color(0.55, 0.75, 0.9)
+	env.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
+	env.ambient_light_color = Color(0.85, 0.85, 0.95)
+	env.ambient_light_energy = 0.7
+	var world_env := WorldEnvironment.new()
+	world_env.environment = env
+	add_child(world_env)
+
+	var sun := DirectionalLight3D.new()
+	sun.rotation_degrees = Vector3(-55, 30, 0)
+	sun.shadow_enabled = true
+	add_child(sun)
+
+
+func _build_room() -> void:
+	# Floor top sits at y = 0, matching the house floor.
+	_add_box(Vector3(0.0, -0.15, 0.0), Vector3(room_size.x, 0.3, room_size.y), FLOOR_COLOR)
+	var half := room_size * 0.5
+	var wall_y := WALL_HEIGHT * 0.5
+	_add_box(Vector3(0.0, wall_y, -half.y), Vector3(room_size.x, WALL_HEIGHT, WALL_THICKNESS), WALL_COLOR)
+	_add_box(Vector3(0.0, wall_y, half.y), Vector3(room_size.x, WALL_HEIGHT, WALL_THICKNESS), WALL_COLOR)
+	_add_box(Vector3(-half.x, wall_y, 0.0), Vector3(WALL_THICKNESS, WALL_HEIGHT, room_size.y), WALL_COLOR)
+	_add_box(Vector3(half.x, wall_y, 0.0), Vector3(WALL_THICKNESS, WALL_HEIGHT, room_size.y), WALL_COLOR)
+
+
+func _add_box(center: Vector3, size: Vector3, color: Color) -> void:
+	var body := StaticBody3D.new()
+	body.collision_layer = 1
+	body.position = center
+
+	var shape := BoxShape3D.new()
+	shape.size = size
+	var col := CollisionShape3D.new()
+	col.shape = shape
+	body.add_child(col)
+
+	var material := StandardMaterial3D.new()
+	material.albedo_color = color
+	var box := BoxMesh.new()
+	box.size = size
+	var mesh := MeshInstance3D.new()
+	mesh.mesh = box
+	mesh.material_override = material
+	body.add_child(mesh)
+	add_child(body)
diff --git a/scripts/world/main_menu.gd b/scripts/world/main_menu.gd
new file mode 100644
index 0000000..f970a4d
--- /dev/null
+++ b/scripts/world/main_menu.gd
@@ -0,0 +1,89 @@
+extends WalkableArea
+class_name MainMenu
+## Main scene. Input sources (keyboard scheme or gamepad) join by holding interact;
+## each joined player appears in the room. Standing on a run-slot pad and pressing
+## interact starts a new run (empty slot) or continues the saved one.
+
+const HOLD_TIME := 0.8
+const SLOT_SPACING := 5.0
+const SLOT_Z := -2.0
+const PAD_SIZE := Vector3(3.0, 0.1, 3.0)
+const SLOT_COLOR := Color(0.95, 0.75, 0.3)
+const PLACEHOLDER_COLOR := Color(0.6, 0.6, 0.65)
+
+var _held: Dictionary[int, float] = {}
+var _status: Label
+
+
+func _init() -> void:
+	room_size = Vector2(20.0, 10.0)
+
+
+func _ready() -> void:
+	super()
+	_status = _build_hud("MOVING DAY!")
+
+	for slot in range(1, SaveManager.SLOT_COUNT + 1):
+		var x := (slot - (SaveManager.SLOT_COUNT + 1) * 0.5) * SLOT_SPACING
+		var zone := add_zone(Vector3(x, 0.0, SLOT_Z), PAD_SIZE, SLOT_COLOR, _slot_text(slot))
+		zone.interacted.connect(_on_slot_interacted.bind(slot))
+	add_zone(Vector3(7.0, 0.0, 2.5), PAD_SIZE, PLACEHOLDER_COLOR, "Wardrobe\nComing soon")
+
+
+func _spawn_point(player_id: int) -> Vector3:
+	return Vector3((player_id - 1.5) * 1.5, 0.1, 3.0)
+
+
+func _process(delta: float) -> void:
+	_poll_joins(delta)
+	_update_text()
+
+
+func _slot_text(slot: int) -> String:
+	var state := SaveManager.peek_run(slot)
+	if state == null:
+		return "Slot %d\nNew run" % slot
+	return "Slot %d\nDay %d  %s" % [slot, state.day, UIKit.money(state.wallet)]
+
+
+func _on_slot_interacted(_player_id: int, slot: int) -> void:
+	if SaveManager.has_run(slot):
+		GameFlow.continue_run(slot)
+	else:
+		GameFlow.new_run(slot)
+	set_process(false)
+	set_physics_process(false)   # a second press must not start the run twice
+
+
+func _poll_joins(delta: float) -> void:
+	for source in InputSetup.available_sources():
+		if InputSetup.assigned_count() >= InputSetup.MAX_PLAYERS:
+			return
+		if InputSetup.is_assigned(source):
+			continue
+		if InputSetup.is_interact_pressed(source):
+			var held: float = _held.get(source, 0.0) + delta
+			_held[source] = held
+			if held >= HOLD_TIME:
+				_held.erase(source)
+				InputSetup.assign(source)
+				spawn_player(InputSetup.assigned_count())
+		else:
+			_held.erase(source)
+
+
+func _update_text() -> void:
+	var lines := PackedStringArray()
+	if InputSetup.assigned_count() < InputSetup.MAX_PLAYERS:
+		lines.append("Hold E, Enter or gamepad A to join")
+	if InputSetup.assigned_count() > 0:
+		lines.append("Stand on a slot and press interact to play")
+	lines.append("")
+	for player_id in range(1, InputSetup.MAX_PLAYERS + 1):
+		if player_id <= InputSetup.assigned_count():
+			lines.append("Player %d: %s" % [player_id, InputSetup.describe(InputSetup.source_of(player_id))])
+		else:
+			lines.append("Player %d: waiting..." % player_id)
+	for source in _held:
+		lines.append("Joining: %s %d%%" % [InputSetup.describe(source), roundi(_held[source] / HOLD_TIME * 100.0)])
+	_status.text = "\n".join(lines)
